# Backend API manzili.
#
# Mahalliy ishlab chiqishda backend odatda 8080-portda turadi:
#   VITE_API_URL=http://localhost:8080
#
# Ishlab chiqarishda — Railway'dagi servis manzili:
#   VITE_API_URL=https://spss-in-uzbek-backend-production.up.railway.app
#
# 🔴 `VITE_` prefiksi majburiy: Vite faqat shu prefiksli o'zgaruvchilarni
# brauzer kodiga uzatadi. Ya'ni bu yerga MAXFIY qiymat yozilmaydi —
# u yig'ilgan JS ichida ochiq ko'rinadi.
VITE_API_URL=http://localhost:8080
